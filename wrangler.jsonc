{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifespace",
  "account_id": "7605a578df1909043d82848907722a87",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  // Prepared under #149 authorization A; production cutover still requires approval.
  // Keep default placement until the measured Free CPU budget issue is resolved.
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "a3307e803a27447f854d2e1a9253b5ae", "localConnectionString": "postgres://lifespace_worker:local-development-only@127.0.0.1:5432/postgres"}],
  "routes": [{"pattern": "lifespace.onepeace.cc.cd", "custom_domain": true}],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {"SUPABASE_URL": "https://zvdcjzjfhkjasikchceo.supabase.co", "PREVIEW_TEST_EMAIL": ""},
  "kv_namespaces": [{"binding": "HOROSCOPE_KV", "id": "57e73bb16a73477d9c307458e0d119ba"}],
  "ratelimits": [
    {"name": "DNSHE_READ_LIMITER", "namespace_id": "20261006", "simple": {"limit": 1, "period": 60}},
    {"name": "NEWS_READ_LIMITER", "namespace_id": "20261007", "simple": {"limit": 30, "period": 60}}
  ],
  "secrets": {"required": ["SUPABASE_SECRET_KEY", "DNSHE_API_KEY", "DNSHE_API_SECRET", "SUPABASE_PUBLISHABLE_KEY", "AUTH_ALLOWED_EMAILS", "AUTH_HOOK_SECRET", "ALAPI_TOKEN"]},
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
