{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifespace",
  "account_id": "7605a578df1909043d82848907722a87",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{"pattern": "lifespace.onepeace.cc.cd", "custom_domain": true}],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {"SUPABASE_URL": "https://zvdcjzjfhkjasikchceo.supabase.co"},
  "ratelimits": [
    {"name": "DNSHE_READ_LIMITER", "namespace_id": "20261006", "simple": {"limit": 1, "period": 60}},
    {"name": "NEWS_READ_LIMITER", "namespace_id": "20261007", "simple": {"limit": 30, "period": 60}}
  ],
  "secrets": {"required": ["SUPABASE_SECRET_KEY", "DNSHE_API_KEY", "DNSHE_API_SECRET"]},
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
